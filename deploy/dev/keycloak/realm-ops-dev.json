      "credentials": [{"type": "password", "value": "${OPS_KC_PERSONA_RILEY_PASSWORD}", "temporary": false}]
    },
    {
      "id": "cb551e64-83ec-582b-9047-8dadf20e151a",
      "username": "jordan",
      "email": "jordan@beta.example",
      "firstName": "Jordan",
      "lastName": "Beta",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["reviewer"],
      "credentials": [{"type": "password", "value": "${OPS_KC_PERSONA_JORDAN_PASSWORD}", "temporary": false}]
    },
    {
      "username": "service-account-ops-view-users",
      "enabled": true,
      "serviceAccountClientId": "ops-view-users",
      "clientRoles": {"realm-management": ["view-users"]}
    }
  ]
}
