# Copy to .github/workflows/ci.yml only after replacing action tags with verified
# full commit SHAs and resolving/committing requirements.lock. See docs/RELEASE.md.
name: reference-ci
on:
  pull_request:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  reference:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - uses: actions/setup-python@v6
        with:
          python-version: "3.13"
      - name: Install locked dependencies
        run: python -m pip install --require-hashes -r requirements.lock
      - name: Install project without resolving dependencies
        run: python -m pip install --no-deps -e .
      - name: Test
        run: python -m pytest -q --junitxml=reports/ci-tests.xml
      - name: Reference scenario
        run: PYTHONPATH=src python -m operations_copilot.cli
      - name: Build container
        run: docker build -t operations-copilot:ci .
