{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operations-copilot:schema:proposal:1",
  "title": "Operations Copilot target proposal v1",
  "$comment": "Target contract. Declarative validation does not implement authentication, authorization, semantic support, atomicity, or runtime integrations.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "canonicalization_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "proposal_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "const": "create_incident"
        },
        "destination": {
          "const": "synthetic-incidents"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2500
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "source_snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "evidence_id",
              "content_sha256",
              "version"
            ]
          },
          "minItems": 1,
          "maxItems": 8
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 8
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 8
        },
        "workflow_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "tenant_id",
        "run_id",
        "proposal_id",
        "revision",
        "action",
        "destination",
        "asset_id",
        "start_at",
        "end_at",
        "title",
        "summary",
        "evidence_refs",
        "source_snapshots",
        "assumptions",
        "limitations",
        "workflow_version",
        "prompt_version",
        "expires_at"
      ]
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "canonicalization_version",
    "payload",
    "payload_sha256"
  ]
}
