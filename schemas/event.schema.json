{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operations-copilot:schema:event:1",
  "title": "Operations Copilot target event v1",
  "$comment": "Target contract. Declarative validation does not implement authentication, authorization, semantic support, atomicity, or runtime integrations.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "conversation_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "run.accepted",
        "clarification.requested",
        "tool.started",
        "tool.completed",
        "proposal.ready",
        "approval.recorded",
        "action.dispatched",
        "action.uncertain",
        "action.confirmed",
        "run.failed",
        "run.cancelled",
        "notification.failed",
        "feedback.recorded",
        "clarification.received",
        "proposal.revised",
        "review.blocked",
        "run.answered",
        "run.insufficient_evidence",
        "run.rejected",
        "action.granted",
        "action.redispatched",
        "action.failed",
        "action.conflict",
        "run.escalated",
        "run.abandoned_unverified",
        "action.late_evidence",
        "explanation.ready"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "source": {
      "enum": [
        "application",
        "destination",
        "model_summary"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2500
        },
        "status": {
          "enum": [
            "QUEUED",
            "AWAITING_INPUT",
            "RETRIEVING",
            "DRAFTING",
            "AWAITING_APPROVAL",
            "APPROVED",
            "EXECUTING",
            "OUTCOME_UNKNOWN",
            "SUCCEEDED",
            "ANSWERED",
            "REJECTED",
            "CANCELLED",
            "INSUFFICIENT_EVIDENCE",
            "FAILED",
            "BLOCKED_REVIEW",
            "ESCALATED",
            "ABANDONED_UNVERIFIED"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "proposal_id": {
          "type": "string",
          "format": "uuid"
        },
        "action_id": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "reason": {
          "type": "string",
          "enum": [
            "cancelled_before_send",
            "aborted_no_commit",
            "rejected",
            "asset_action_unresolved",
            "asset_incident_exists",
            "expired",
            "stale_evidence",
            "authority_revoked",
            "conflict",
            "escalation_deadline"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "SUCCEEDED",
            "FAILED_NO_COMMIT"
          ]
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "receipt_id": {
              "type": "string",
              "format": "uuid"
            },
            "incident_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "committed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
            }
          },
          "required": [
            "receipt_id",
            "incident_id",
            "committed_at"
          ]
        },
        "tombstone": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action_id": {
              "type": "string",
              "format": "uuid"
            },
            "state": {
              "type": "string",
              "enum": [
                "ABORTED",
                "REJECTED"
              ]
            },
            "payload_sha256": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "decided_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
            }
          },
          "required": [
            "action_id",
            "state",
            "payload_sha256",
            "reason",
            "decided_at"
          ]
        }
      },
      "required": []
    }
  },
  "required": [
    "event_id",
    "tenant_id",
    "conversation_id",
    "run_id",
    "sequence",
    "type",
    "occurred_at",
    "source",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "model_summary"
          }
        }
      },
      "then": {
        "properties": {
          "type": {
            "const": "explanation.ready"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2500
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "minItems": 0,
                "maxItems": 8,
                "uniqueItems": true
              }
            },
            "required": [
              "message"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "destination"
          }
        }
      },
      "then": {
        "properties": {
          "type": {
            "enum": [
              "action.confirmed",
              "action.failed",
              "action.conflict",
              "action.late_evidence"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "action.confirmed",
              "action.failed",
              "action.conflict",
              "action.late_evidence"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "const": "destination"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^(action|run|review)\\."
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "enum": [
              "application",
              "destination"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "action.confirmed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "status",
              "receipt"
            ],
            "properties": {
              "status": {
                "const": "SUCCEEDED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "action.late_evidence"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "outcome"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "const": "SUCCEEDED"
                    }
                  }
                },
                "then": {
                  "required": [
                    "receipt"
                  ],
                  "not": {
                    "required": [
                      "tombstone"
                    ]
                  }
                },
                "else": {
                  "required": [
                    "tombstone"
                  ],
                  "not": {
                    "required": [
                      "receipt"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "action.failed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "cancelled_before_send",
                  "aborted_no_commit",
                  "rejected",
                  "expired"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "action.confirmed",
              "action.failed",
              "action.late_evidence"
            ]
          }
        }
      },
      "then": {
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "action.confirmed"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "not": {
                    "required": [
                      "tombstone"
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "action.failed"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "not": {
                    "required": [
                      "receipt"
                    ]
                  }
                }
              }
            }
          }
        ]
      },
      "else": {
        "properties": {
          "payload": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "outcome"
                  ]
                },
                {
                  "required": [
                    "receipt"
                  ]
                },
                {
                  "required": [
                    "tombstone"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
