{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operations-copilot:schema:action-outcome:1",
  "title": "Operations Copilot target action-outcome v1",
  "$comment": "Target contract. Declarative validation does not implement authentication, authorization, semantic support, atomicity, or runtime integrations.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED_NO_COMMIT",
        "UNKNOWN",
        "CONFLICT"
      ]
    },
    "action_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "receipt_id": {
              "type": "string",
              "format": "uuid"
            },
            "incident_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "committed_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "receipt_id",
            "incident_id",
            "committed_at"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "tombstone": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action_id": {
              "type": "string",
              "format": "uuid"
            },
            "state": {
              "type": "string",
              "enum": [
                "ABORTED",
                "REJECTED"
              ]
            },
            "payload_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "decided_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "action_id",
            "state",
            "payload_sha256",
            "reason",
            "decided_at"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "cancelled_before_send",
            "aborted_no_commit",
            "rejected",
            "expired"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "action_id",
    "payload_sha256",
    "receipt",
    "tombstone",
    "reason"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "receipt": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "receipt_id": {
                "type": "string",
                "format": "uuid"
              },
              "incident_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "committed_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "receipt_id",
              "incident_id",
              "committed_at"
            ]
          },
          "tombstone": {
            "type": "null"
          },
          "reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAILED_NO_COMMIT"
          }
        }
      },
      "then": {
        "properties": {
          "tombstone": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action_id": {
                "type": "string",
                "format": "uuid"
              },
              "state": {
                "type": "string",
                "enum": [
                  "ABORTED",
                  "REJECTED"
                ]
              },
              "payload_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "decided_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "action_id",
              "state",
              "payload_sha256",
              "reason",
              "decided_at"
            ]
          },
          "receipt": {
            "type": "null"
          },
          "reason": {
            "type": "string",
            "enum": [
              "cancelled_before_send",
              "aborted_no_commit",
              "rejected",
              "expired"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "UNKNOWN",
              "CONFLICT"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "receipt": {
            "type": "null"
          },
          "tombstone": {
            "type": "null"
          },
          "reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}
