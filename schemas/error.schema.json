{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operations-copilot:schema:error:1",
  "title": "Operations Copilot target error v1",
  "$comment": "Target contract. Declarative validation does not implement authentication, authorization, semantic support, atomicity, or runtime integrations.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "NOT_FOUND",
        "VERSION_CONFLICT",
        "IDEMPOTENCY_CONFLICT",
        "INVALID_INPUT",
        "RATE_LIMITED",
        "UNAVAILABLE",
        "ASSET_ACTION_UNRESOLVED",
        "ASSET_INCIDENT_EXISTS",
        "GRANT_EXISTS",
        "SLOT_OCCUPIED",
        "AUTHORITY_VIOLATION"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "retryable": {
      "type": "boolean"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "code",
    "message",
    "retryable",
    "request_id"
  ]
}
