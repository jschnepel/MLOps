{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operations-copilot:schema:message:1",
  "title": "Operations Copilot target message v1",
  "$comment": "Target contract. Declarative validation does not implement authentication, authorization, semantic support, atomicity, or runtime integrations.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "investigate",
        "question"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"
        },
        "hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        }
      },
      "required": []
    }
  },
  "required": [
    "kind",
    "text"
  ]
}
