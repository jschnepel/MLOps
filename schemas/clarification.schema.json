{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operations-copilot:schema:clarification:1",
  "title": "Operations Copilot target clarification v1",
  "$comment": "Target contract. Declarative validation does not implement authentication, authorization, semantic support, atomicity, or runtime integrations.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "question_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[A-Z][A-Z0-9_-]{0,31}(?![\\s\\S])"
        },
        "hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        }
      },
      "required": [],
      "minProperties": 1
    }
  },
  "required": [
    "question_id",
    "expected_version",
    "context"
  ]
}
