{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:operations-copilot:schema:decision:1",
  "title": "Operations Copilot target decision v1",
  "$comment": "Target contract. Declarative validation does not implement authentication, authorization, semantic support, atomicity, or runtime integrations.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision": {
      "enum": [
        "approve",
        "reject"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 0,
      "maxLength": 500
    }
  },
  "required": [
    "expected_revision",
    "expected_payload_sha256",
    "decision"
  ]
}
